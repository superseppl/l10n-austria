<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_at_pos_rksv_fiskaly.OrderReceipt"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <t t-if="order.fiskaly_outage">
                <br />
                <!-- RKSV §17(4) prescribes this wording verbatim. -->
                <b>Sicherheitseinrichtung ausgefallen</b>
            </t>
        </xpath>
    </t>
</templates>
